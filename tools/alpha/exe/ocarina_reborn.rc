#include <winver.h>
1 ICON "../OcarinaReborn.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_COMMA
PRODUCTVERSION VER_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Ocarina Reborn"
      VALUE "FileDescription", "Ocarina Reborn"
      VALUE "FileVersion", VER_TEXT
      VALUE "InternalName", "ocarina-reborn-alpha-001"
      VALUE "OriginalFilename", "OcarinaReborn.exe"
      VALUE "ProductName", "Ocarina Reborn"
      VALUE "ProductVersion", VER_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
